{
  "name": "@agentlinkprotocol/typescript-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Agent Link Protocol Atlas: agent keys, signing, sealing, and the Grid local API client",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentlinkprotocol/typescript-sdk.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "GRID_URL=${GRID_URL:-http://127.0.0.1:7777} vitest run --config vitest.integration.config.ts",
    "generate": "openapi-typescript ../grid/openapi.json -o src/generated/openapi.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
